---
// src/components/privpaste/PrivacyFeatures.astro
import SectionHeader from '../ui/SectionHeader.astro';

const features = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'AES-256-GCM Encryption',
    description: 'Every paste is encrypted in-browser using the Web Crypto API (AES-256-GCM) before any data leaves your device. The server receives only ciphertext — it is mathematically impossible to read your content.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>`,
    title: 'Key Lives in the URL',
    description: 'The encryption key is embedded exclusively in the URL fragment (#key=…). URL fragments are never sent to the server by browsers — not in requests, not in logs. Your key is yours alone.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
    title: 'No Accounts Required',
    description: 'PrivPaste is fully anonymous. No sign-up, no email, no cookies, no fingerprinting. Create a paste and share the link — that is the entire flow.',
  },
];
---

<section class="privacy-section">
  <div class="privacy-container">
    <SectionHeader
      eyebrow="Privacy"
      title="Zero knowledge by design"
      subtitle="Your content is encrypted before it leaves your browser. We can't read it. No one can."
    />
    <div class="privacy-grid">
      {features.map((f) => (
        <div class="privacy-card">
          <div class="privacy-icon" set:html={f.icon} />
          <h3 class="privacy-title">{f.title}</h3>
          <p class="privacy-desc">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .privacy-section {
    padding: 6rem 1.5rem;
    background: var(--color-bg);
    position: relative;
  }
  .privacy-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.3), transparent);
  }
  .privacy-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .privacy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  @media (min-width: 640px) {
    .privacy-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .privacy-card {
    background: var(--color-surface);
    border: 1px solid rgba(108, 99, 255, 0.15);
    border-radius: 1rem;
    padding: 2rem;
    opacity: 0;
    transform: translateY(24px);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .privacy-card:hover {
    border-color: rgba(0, 212, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 212, 255, 0.1);
  }
  .privacy-icon {
    width: 48px;
    height: 48px;
    color: var(--color-accent-secondary);
    margin-bottom: 1.25rem;
  }
  .privacy-icon svg {
    width: 100%;
    height: 100%;
  }
  .privacy-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
  }
  .privacy-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.to('.privacy-card', {
    opacity: 1,
    y: 0,
    duration: 0.6,
    stagger: 0.15,
    ease: 'power2.out',
    scrollTrigger: {
      trigger: '.privacy-grid',
      start: 'top 80%',
      once: true,
    },
  });
</script>
