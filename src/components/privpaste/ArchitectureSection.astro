---
// src/components/privpaste/ArchitectureSection.astro
---

<section class="arch-section">
  <div class="arch-container">
    <div class="arch-grid">
      <!-- Left: SVG diagram -->
      <div class="arch-diagram">
        <svg
          viewBox="0 0 480 360"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-label="Architecture diagram showing encryption flow between browser and server"
        >
          <!-- Browser box -->
          <rect x="20" y="20" width="180" height="320" rx="12" fill="var(--color-surface)" stroke="rgba(108,99,255,0.4)" stroke-width="1.5"/>
          <text x="110" y="50" text-anchor="middle" fill="#f0f0f0" font-family="monospace" font-size="14" font-weight="700">Browser</text>

          <!-- Server box -->
          <rect x="280" y="20" width="180" height="320" rx="12" fill="var(--color-surface)" stroke="rgba(108,99,255,0.4)" stroke-width="1.5"/>
          <text x="370" y="50" text-anchor="middle" fill="#f0f0f0" font-family="monospace" font-size="14" font-weight="700">Server</text>

          <!-- Plaintext paste label -->
          <rect x="40" y="75" width="140" height="36" rx="6" fill="rgba(108,99,255,0.15)" stroke="rgba(108,99,255,0.3)" stroke-width="1"/>
          <text x="110" y="97" text-anchor="middle" fill="#c4c0ff" font-family="monospace" font-size="11">[plaintext paste]</text>

          <!-- Arrow down: plaintext → Web Crypto -->
          <line x1="110" y1="111" x2="110" y2="135" stroke="#6c63ff" stroke-width="1.5" marker-end="url(#arrowViolet)"/>
          <text x="115" y="128" fill="#888" font-family="monospace" font-size="10">Web Crypto API</text>

          <!-- Ciphertext label -->
          <rect x="40" y="140" width="140" height="36" rx="6" fill="rgba(0,212,255,0.1)" stroke="rgba(0,212,255,0.3)" stroke-width="1"/>
          <text x="110" y="162" text-anchor="middle" fill="#00d4ff" font-family="monospace" font-size="11">[ciphertext]</text>

          <!-- Arrow right: POST ciphertext to server -->
          <line x1="180" y1="158" x2="280" y2="158" stroke="#6c63ff" stroke-width="1.5" marker-end="url(#arrowViolet)"/>
          <text x="230" y="150" text-anchor="middle" fill="#888" font-family="monospace" font-size="10">POST</text>

          <!-- Server stores ciphertext -->
          <rect x="300" y="140" width="140" height="36" rx="6" fill="rgba(0,212,255,0.1)" stroke="rgba(0,212,255,0.3)" stroke-width="1"/>
          <text x="370" y="157" text-anchor="middle" fill="#00d4ff" font-family="monospace" font-size="10">stores</text>
          <text x="370" y="170" text-anchor="middle" fill="#00d4ff" font-family="monospace" font-size="10">ciphertext</text>

          <!-- Arrow left: returns paste ID -->
          <line x1="280" y1="195" x2="180" y2="195" stroke="#6c63ff" stroke-width="1.5" marker-end="url(#arrowVioletLeft)"/>
          <text x="230" y="187" text-anchor="middle" fill="#888" font-family="monospace" font-size="10">paste ID</text>

          <!-- URL fragment label in browser -->
          <rect x="40" y="220" width="140" height="52" rx="6" fill="rgba(0,212,255,0.08)" stroke="rgba(0,212,255,0.2)" stroke-width="1" stroke-dasharray="4,2"/>
          <text x="110" y="240" text-anchor="middle" fill="#ccc" font-family="monospace" font-size="9">/p/{'{'}id{'}'}</text>
          <text x="110" y="255" text-anchor="middle" fill="#00d4ff" font-family="monospace" font-size="9">#key=abc123</text>
          <text x="110" y="268" text-anchor="middle" fill="#888" font-family="monospace" font-size="9">↑ fragment</text>

          <!-- Red crossed arrow from fragment toward server -->
          <line x1="180" y1="246" x2="260" y2="246" stroke="#ff4444" stroke-width="1.5" stroke-dasharray="5,3"/>
          <line x1="248" y1="238" x2="262" y2="252" stroke="#ff4444" stroke-width="2"/>
          <line x1="248" y1="252" x2="262" y2="238" stroke="#ff4444" stroke-width="2"/>
          <text x="220" y="265" text-anchor="middle" fill="#ff4444" font-family="monospace" font-size="8">never sent</text>

          <!-- Arrow defs -->
          <defs>
            <marker id="arrowViolet" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
              <path d="M0,0 L0,6 L8,3 z" fill="#6c63ff"/>
            </marker>
            <marker id="arrowVioletLeft" markerWidth="8" markerHeight="8" refX="2" refY="3" orient="auto">
              <path d="M8,0 L8,6 L0,3 z" fill="#6c63ff"/>
            </marker>
          </defs>
        </svg>
      </div>

      <!-- Right: prose -->
      <div class="arch-prose">
        <p class="arch-eyebrow">Privacy Model</p>
        <h2 class="arch-heading">How your key stays private</h2>
        <div class="arch-body">
          <p>
            When you create a paste, PrivPaste generates a random 256-bit AES key entirely
            in your browser. The paste content is encrypted with that key before any
            network request is made.
          </p>
          <p>
            The encrypted ciphertext is sent to the server. The key is never included.
          </p>
          <p>
            The key is appended to the share URL as a fragment identifier
            (<code>#key=…</code>). Browsers intentionally omit URL fragments from HTTP
            requests — it is a browser standard, not a PrivPaste promise. Even if the
            server were compromised, an attacker would only obtain ciphertext.
          </p>
          <p>
            When a recipient opens the link, their browser extracts the key from the
            fragment, fetches the ciphertext, and decrypts it locally — entirely in
            their browser.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .arch-section {
    padding: 6rem 1.5rem;
    background: var(--color-surface);
    position: relative;
  }
  .arch-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108, 99, 255, 0.3), transparent);
  }
  .arch-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .arch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .arch-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 4rem;
    }
  }
  .arch-diagram svg {
    width: 100%;
    height: auto;
  }
  .arch-eyebrow {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 0 0 0.75rem;
  }
  .arch-heading {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 800;
    color: #f0f0f0;
    margin: 0 0 1.5rem;
    line-height: 1.2;
  }
  .arch-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .arch-body p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin: 0;
  }
  .arch-body code {
    font-family: 'Geist Mono', monospace;
    font-size: 0.85em;
    color: var(--color-accent-secondary);
    background: rgba(0, 212, 255, 0.08);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.arch-diagram', {
    opacity: 0,
    x: -40,
    duration: 0.8,
    ease: 'power2.out',
    scrollTrigger: {
      trigger: '.arch-section',
      start: 'top 75%',
      once: true,
    },
  });

  gsap.from('.arch-prose', {
    opacity: 0,
    x: 40,
    duration: 0.8,
    ease: 'power2.out',
    delay: 0.1,
    scrollTrigger: {
      trigger: '.arch-section',
      start: 'top 75%',
      once: true,
    },
  });
</script>
