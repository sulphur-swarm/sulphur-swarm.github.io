---
// src/components/privpaste/PaymentsSection.astro

const bullets = [
  { emoji: '🔌', text: 'Connect any EVM wallet — MetaMask, Coinbase Wallet, or any WalletConnect-compatible app' },
  { emoji: '💳', text: 'Pay with USDC on Base L2 — gas fees under $0.01' },
  { emoji: '⚡', text: 'Instant activation: on-chain confirmation unlocks premium features automatically' },
  { emoji: '🔒', text: 'No wallet-to-account linkage, no credit card, no KYC — pseudonymous by design' },
];
---

<section class="payments-section">
  <div class="payments-container">
    <div class="payments-card">
      <div class="payments-content">
        <p class="payments-eyebrow">Privacy + Payments</p>
        <h2 class="payments-heading">Connect. Pay. Done.</h2>
        <p class="payments-body">
          PrivPaste is free for basic use. To unlock longer retention, larger paste sizes, and
          custom expiry windows, connect your EVM wallet and send a USDC microtransaction on
          Base L2. The frontend detects confirmation on-chain and activates your premium session
          instantly — no account required, no email, no billing dashboard.
        </p>
        <ul class="payments-bullets">
          {bullets.map((b) => (
            <li class="payments-bullet">
              <span class="bullet-emoji" aria-hidden="true">{b.emoji}</span>
              <span>{b.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .payments-section {
    padding: 6rem 1.5rem;
    background: var(--color-surface);
    position: relative;
  }
  .payments-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108, 99, 255, 0.3), transparent);
  }
  .payments-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .payments-card {
    border: 1px solid rgba(108, 99, 255, 0.25);
    border-radius: 1.5rem;
    padding: 3rem;
    background: radial-gradient(ellipse 70% 80% at 100% 50%, rgba(0, 212, 255, 0.06) 0%, transparent 60%);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 1.0s ease, transform 1.0s ease;
  }
  .payments-card.is-visible {
    opacity: 1;
    transform: scale(1);
  }
  @media (min-width: 1024px) {
    .payments-card {
      padding: 5rem;
    }
  }
  .payments-content {
    max-width: 640px;
  }
  .payments-eyebrow {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-secondary);
    margin-bottom: 0.75rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .payments-eyebrow.is-visible { opacity: 1; transform: translateY(0); }
  .payments-heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1.25rem;
    background: linear-gradient(135deg, #fff 0%, #6c63ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: 0.12s;
  }
  .payments-heading.is-visible { opacity: 1; transform: translateY(0); }
  .payments-body {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin: 0 0 2rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: 0.24s;
  }
  .payments-body.is-visible { opacity: 1; transform: translateY(0); }
  .payments-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    transition-delay: 0.36s;
  }
  .payments-bullets.is-visible { opacity: 1; transform: translateY(0); }
  @media (scripting: none) {
    .payments-card, .payments-eyebrow, .payments-heading, .payments-body, .payments-bullets {
      opacity: 1; transform: none;
    }
  }
  .payments-bullet {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .bullet-emoji {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.05em;
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        document.querySelector('.payments-card')?.classList.add('is-visible');
        document.querySelector('.payments-eyebrow')?.classList.add('is-visible');
        document.querySelector('.payments-heading')?.classList.add('is-visible');
        document.querySelector('.payments-body')?.classList.add('is-visible');
        document.querySelector('.payments-bullets')?.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  const section = document.querySelector('.payments-section');
  if (section) observer.observe(section);
</script>
