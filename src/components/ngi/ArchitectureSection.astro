---
import SectionHeader from '../ui/SectionHeader.astro';

const pillars = [
  {
    eyebrow: 'Core Architecture',
    name: 'FENA',
    fullName: 'Free Energy Neural Architecture',
    color: '#6c63ff',
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="#6c63ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="24,4 42,15 42,33 24,44 6,33 6,15"/><circle cx="24" cy="24" r="6"/><line x1="24" y1="4" x2="24" y2="18"/><line x1="24" y1="30" x2="24" y2="44"/><line x1="6" y1="15" x2="18" y2="22"/><line x1="30" y1="26" x2="42" y2="33"/></svg>`,
    description: 'A 15-node modular brain inspired by predictive coding and free energy principles. Hierarchical processing with continuous-time dynamics — each node predicts, compares, and updates in real time.',
    points: ['15 specialized neural modules', 'Continuous-time dynamics', 'Hierarchical prediction'],
  },
  {
    eyebrow: 'Learning Mechanism',
    name: 'PCLG',
    fullName: 'Predictive Coding Learning Gate',
    color: '#00d4ff',
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="#00d4ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 24h8"/><path d="M32 24h8"/><rect x="16" y="14" width="16" height="20" rx="3"/><path d="M20 20v8"/><path d="M24 18v12"/><path d="M28 20v8"/><circle cx="8" cy="24" r="2"/><circle cx="40" cy="24" r="2"/></svg>`,
    description: 'A novel bio-plausible learning mechanism that replaces backpropagation entirely. Local learning rules minimize prediction error at each node — no global loss function required.',
    points: ['No backpropagation', 'Local prediction error minimization', 'Bio-plausible learning rules'],
  },
  {
    eyebrow: 'Environment Model',
    name: 'World Model',
    fullName: 'Slot-Based World Model',
    color: 'url(#wm-gradient)',
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><defs><linearGradient id="wm-icon-grad" x1="0" y1="0" x2="48" y2="48"><stop offset="0%" stop-color="#6c63ff"/><stop offset="100%" stop-color="#00d4ff"/></linearGradient></defs><circle cx="24" cy="24" r="18" stroke="url(#wm-icon-grad)"/><ellipse cx="24" cy="24" rx="18" ry="8" stroke="url(#wm-icon-grad)"/><line x1="24" y1="6" x2="24" y2="42" stroke="url(#wm-icon-grad)"/><path d="M8 14c4 3 10 5 16 5s12-2 16-5" stroke="url(#wm-icon-grad)"/><path d="M8 34c4-3 10-5 16-5s12 2 16 5" stroke="url(#wm-icon-grad)"/></svg>`,
    description: 'A slot-based architecture for learning environment dynamics. 512 slots encode a rich internal representation of reality — a learned simulation the system uses to predict and plan.',
    points: ['512-slot state representation', 'Predictive modeling', 'Learned internal simulation'],
  },
];
---

<section class="ngi-arch-section">
  <div class="ngi-arch-container">
    <SectionHeader
      eyebrow="Architecture"
      title="Three pillars of intelligence"
      subtitle="Each component is novel. Together, they form a unified system that perceives, learns, and adapts."
    />

    <div class="ngi-arch-grid">
      {pillars.map((p, i) => (
        <div class="ngi-arch-card ngi-animate" style={`--card-accent: ${p.color === 'url(#wm-gradient)' ? '#6c63ff' : p.color}; --card-index: ${i};`}>
          <div class="ngi-arch-card-top" style={`background: ${p.color === 'url(#wm-gradient)' ? 'linear-gradient(90deg, #6c63ff, #00d4ff)' : p.color};`}></div>
          <div class="ngi-arch-icon" set:html={p.icon} />
          <span class="ngi-arch-eyebrow">{p.eyebrow}</span>
          <h3 class="ngi-arch-name">{p.name}</h3>
          <span class="ngi-arch-fullname">{p.fullName}</span>
          <p class="ngi-arch-desc">{p.description}</p>
          <ul class="ngi-arch-points">
            {p.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Connection flow SVG (desktop only) -->
    <div class="ngi-arch-flow" aria-hidden="true">
      <svg viewBox="0 0 900 50" fill="none" xmlns="http://www.w3.org/2000/svg" class="ngi-flow-svg">
        <defs>
          <linearGradient id="wm-gradient" x1="0" y1="0" x2="900" y2="0">
            <stop offset="0%" stop-color="#6c63ff"/>
            <stop offset="100%" stop-color="#00d4ff"/>
          </linearGradient>
        </defs>
        <line x1="50" y1="25" x2="850" y2="25" stroke="url(#wm-gradient)" stroke-width="1.5" stroke-dasharray="6 4" class="ngi-flow-line"/>
        <!-- Flow labels -->
        <text x="25" y="29" fill="#888" font-size="10" font-family="Geist Mono, monospace">Input</text>
        <circle cx="170" cy="25" r="4" fill="#6c63ff"/>
        <text x="185" y="29" fill="#888" font-size="10" font-family="Geist Mono, monospace">FENA</text>
        <path d="M230 25 L250 25 L245 20 M250 25 L245 30" stroke="#6c63ff" stroke-width="1.5"/>
        <circle cx="420" cy="25" r="4" fill="#00d4ff"/>
        <text x="435" y="29" fill="#888" font-size="10" font-family="Geist Mono, monospace">PCLG</text>
        <path d="M485 25 L505 25 L500 20 M505 25 L500 30" stroke="#00d4ff" stroke-width="1.5"/>
        <circle cx="670" cy="25" r="4" fill="#6c63ff"/>
        <text x="685" y="29" fill="#888" font-size="10" font-family="Geist Mono, monospace">World Model</text>
        <path d="M790 25 L810 25 L805 20 M810 25 L805 30" stroke="#00d4ff" stroke-width="1.5"/>
        <text x="825" y="29" fill="#888" font-size="10" font-family="Geist Mono, monospace">Predictions</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .ngi-arch-section {
    padding: 6rem 1.5rem;
    background: var(--color-surface);
    position: relative;
  }
  .ngi-arch-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108,99,255,0.3), transparent);
  }
  .ngi-arch-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .ngi-arch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  @media (min-width: 768px) {
    .ngi-arch-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .ngi-arch-card {
    background: rgba(8, 9, 12, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.25s, box-shadow 0.25s;
    transition-delay: calc(var(--card-index) * 0.15s);
  }
  .ngi-arch-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .ngi-arch-card:hover {
    transform: translateY(-4px) !important;
    border-color: rgba(108, 99, 255, 0.3);
    box-shadow: 0 8px 30px rgba(108, 99, 255, 0.1);
  }
  @media (scripting: none) {
    .ngi-arch-card { opacity: 1; transform: none; }
  }
  .ngi-arch-card-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-radius: 1rem 1rem 0 0;
  }
  .ngi-arch-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 1rem;
  }
  .ngi-arch-icon svg { width: 100%; height: 100%; }
  .ngi-arch-eyebrow {
    display: block;
    font-family: 'Geist Mono', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--card-accent);
    margin-bottom: 0.5rem;
  }
  .ngi-arch-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem;
  }
  .ngi-arch-fullname {
    display: block;
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .ngi-arch-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .ngi-arch-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ngi-arch-points li {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    padding-left: 1rem;
    position: relative;
  }
  .ngi-arch-points li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--card-accent);
  }
  .ngi-arch-flow {
    margin-top: 3rem;
    display: none;
  }
  @media (min-width: 768px) {
    .ngi-arch-flow { display: block; }
  }
  .ngi-flow-svg {
    width: 100%;
    height: auto;
  }
  .ngi-flow-line {
    stroke-dashoffset: 1200;
    transition: stroke-dashoffset 2s ease;
  }
  .ngi-arch-section.is-visible .ngi-flow-line {
    stroke-dashoffset: 0;
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.ngi-arch-card').forEach(el => el.classList.add('is-visible'));
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  const section = document.querySelector('.ngi-arch-section');
  if (section) observer.observe(section);
</script>
