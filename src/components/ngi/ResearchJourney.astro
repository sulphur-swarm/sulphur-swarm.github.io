---
import SectionHeader from '../ui/SectionHeader.astro';

const phases = [
  {
    number: 1,
    title: 'Hebbian Learning',
    status: 'Completed — Exceeded',
    statusColor: '#e8a838',
    description: 'Started with Hebbian learning rules — the simplest bio-plausible approach. Showed real promise for unsupervised feature extraction, but hit fundamental limitations: no error-driven correction and inability to learn complex mappings.',
  },
  {
    number: 2,
    title: 'Decoder / Extractor',
    status: 'Completed — Pivoted',
    statusColor: '#e8a838',
    description: 'Tried an MLP decoder to extract language from the world model. Hit an information bottleneck — loss plateaued at random-chance level (6.2). The world model\'s 512-slot representation simply didn\'t encode linguistic information the way we expected.',
  },
  {
    number: 3,
    title: 'DTP — Difference Target Propagation',
    status: 'Completed — Validated',
    statusColor: '#4ade80',
    description: 'Proved the world model CAN learn. DTP provided a bio-plausible alternative to backpropagation that actually drove meaningful learning in the architecture. A critical validation that the core approach was sound.',
  },
  {
    number: 4,
    title: 'PCLG — The Breakthrough',
    status: 'Active',
    statusColor: '#6c63ff',
    description: 'The Predictive Coding Learning Gate — a novel learning mechanism that combines predictive coding with local learning rules. This is the current focus and represents the key innovation that makes the entire architecture work.',
  },
];
---

<section class="ngi-journey-section">
  <div class="ngi-journey-container">
    <SectionHeader
      eyebrow="Research Journey"
      title="From first principles to breakthrough"
      subtitle="Every phase taught us something essential. The failures were as important as the successes."
    />

    <div class="ngi-timeline">
      <div class="ngi-timeline-line" aria-hidden="true">
        <div class="ngi-timeline-line-fill"></div>
      </div>

      {phases.map((phase) => (
        <div class="ngi-phase-row" style={`--phase-color: ${phase.statusColor};`}>
          <div class="ngi-phase-dot" aria-hidden="true">
            <div class="ngi-phase-dot-inner"></div>
          </div>
          <div class="ngi-phase-card">
            <div class="ngi-phase-header">
              <span class="ngi-phase-number">Phase {phase.number}</span>
              <span class="ngi-phase-status" style={`background: ${phase.statusColor}20; color: ${phase.statusColor};`}>
                {phase.status}
              </span>
            </div>
            <h3 class="ngi-phase-title">{phase.title}</h3>
            <p class="ngi-phase-desc">{phase.description}</p>
            <div class="ngi-phase-bottom-border" style={`background: linear-gradient(90deg, ${phase.statusColor}, transparent);`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ngi-journey-section {
    padding: 6rem 1.5rem;
    background: var(--color-bg);
    position: relative;
  }
  .ngi-journey-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108,99,255,0.3), transparent);
  }
  .ngi-journey-container {
    max-width: 900px;
    margin: 0 auto;
  }
  .ngi-timeline {
    margin-top: 3rem;
    position: relative;
    padding-left: 2.5rem;
  }
  @media (min-width: 768px) {
    .ngi-timeline { padding-left: 3.5rem; }
  }
  .ngi-timeline-line {
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(108, 99, 255, 0.1);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .ngi-timeline-line { left: 14px; }
  }
  .ngi-timeline-line-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, #6c63ff, #00d4ff);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ngi-journey-section.is-visible .ngi-timeline-line-fill {
    transform: scaleY(1);
  }

  .ngi-phase-row {
    position: relative;
    margin-bottom: 2rem;
  }
  .ngi-phase-row:last-child { margin-bottom: 0; }

  .ngi-phase-dot {
    position: absolute;
    left: -2.5rem;
    top: 1.5rem;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 768px) {
    .ngi-phase-dot { left: -3.5rem; width: 30px; height: 30px; }
  }
  .ngi-phase-dot-inner {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--phase-color);
    box-shadow: 0 0 12px var(--phase-color);
    transform: scale(0);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ngi-phase-row.is-visible .ngi-phase-dot-inner {
    transform: scale(1);
  }

  .ngi-phase-card {
    background: rgba(8, 9, 12, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-30px);
    transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.25s, box-shadow 0.25s;
  }
  .ngi-phase-row.is-visible .ngi-phase-card {
    opacity: 1;
    transform: translateX(0);
  }
  .ngi-phase-card:hover {
    border-color: rgba(108, 99, 255, 0.2);
    box-shadow: 0 4px 20px rgba(108, 99, 255, 0.06);
  }
  @media (scripting: none) {
    .ngi-phase-card { opacity: 1; transform: none; }
    .ngi-phase-dot-inner { transform: scale(1); }
    .ngi-timeline-line-fill { transform: scaleY(1); }
  }

  .ngi-phase-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }
  .ngi-phase-number {
    font-family: 'Geist Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }
  .ngi-phase-status {
    font-family: 'Geist Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }
  .ngi-phase-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
  }
  .ngi-phase-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
  .ngi-phase-bottom-border {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 0 0 1rem 1rem;
  }
</style>

<script>
  // Section-level observer for timeline line
  const sectionObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        sectionObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  const journeySection = document.querySelector('.ngi-journey-section');
  if (journeySection) sectionObs.observe(journeySection);

  // Per-phase observer for staggered card reveals
  const phaseObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        phaseObs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('.ngi-phase-row').forEach(row => phaseObs.observe(row));
</script>
