---
const lpLockerIcon = `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
</svg>`;

const privPasteIcon = `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
</svg>`;

const simpleMultisigIcon = `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
  <circle cx="9" cy="7" r="4"/>
  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
</svg>`;

const services = [
  {
    title: 'LP Locker',
    description: 'Lock liquidity pool tokens with confidence. Time-lock your LP positions on-chain — no trust required, no early withdrawals, full transparency.',
    icon: lpLockerIcon,
    href: '/lplocker/',
  },
  {
    title: 'PrivPaste',
    description: 'End-to-end encrypted paste sharing. Share sensitive text, code, or notes privately — zero knowledge, zero logs, zero compromise.',
    icon: privPasteIcon,
    href: '/privpaste/',
  },
  {
    title: 'SimpleMultisig',
    description: 'Straightforward multi-signature wallets. Create and manage multisig transactions without complexity — secure collective control made simple.',
    icon: simpleMultisigIcon,
    href: '/simplemultisig/',
  },
];
---

<section class="services-grid-section py-20 md:py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="services-grid grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {services.map((service) => (
        <div class="service-card group relative rounded-xl transition-all duration-300 p-6 flex flex-col bg-[rgba(14,17,23,0.8)] border border-[rgba(108,99,255,0.3)] hover:-translate-y-1 hover:border-[rgba(108,99,255,0.6)] hover:shadow-[0_8px_30px_rgba(108,99,255,0.2)] cursor-pointer backdrop-blur-sm">
          <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-[#6c63ff] to-[#00d4ff]"></div>
          <a href={service.href} class="flex flex-col flex-1 h-full no-underline" tabindex="0">
            <div class="w-12 h-12 mb-4 text-[#6c63ff]">
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-xl font-bold text-[#f0f0f0] mb-2">{service.title}</h3>
            <p class="text-[#888] text-base leading-relaxed mt-2 mb-6">{service.description}</p>
            <div class="mt-auto pt-4">
              <span class="inline-flex items-center justify-center px-4 py-2 text-sm border border-[#6c63ff] text-[#6c63ff] rounded-lg transition-all duration-200 group-hover:bg-[#6c63ff] group-hover:text-white">Learn More →</span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo(
    '.service-card',
    { opacity: 0, y: 30 },
    {
      opacity: 1,
      y: 0,
      duration: 0.5,
      stagger: 0.12,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '.services-grid',
        start: 'top 80%',
        once: true,
      },
    }
  );
</script>
