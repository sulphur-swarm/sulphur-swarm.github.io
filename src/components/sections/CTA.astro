---
// src/components/sections/CTA.astro
---

<section class="cta-section" id="cta">
  <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28">

    <!-- CTA card -->
    <div class="cta-card relative overflow-hidden rounded-3xl p-12 lg:p-20 text-center border"
         style="background: var(--color-surface); border-color: rgba(108, 99, 255, 0.3);">

      <!-- Background glow -->
      <div class="absolute inset-0 pointer-events-none"
           style="background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(108, 99, 255, 0.12) 0%, transparent 70%);"></div>

      <!-- Content -->
      <div class="relative z-10">
        <p class="cta-eyebrow text-sm font-mono tracking-widest uppercase mb-6"
           style="color: var(--color-accent-secondary);">
          Get started
        </p>

        <h2 class="cta-headline text-4xl lg:text-6xl font-extrabold leading-tight mb-6"
            style="color: var(--color-text-primary);">
          See the swarm<br />in action.
        </h2>

        <p class="cta-desc text-lg leading-relaxed mb-10 max-w-xl mx-auto"
           style="color: var(--color-text-secondary);">
          The Sulphur AI Swarm is live. Reach out to explore what autonomous
          multi-agent engineering can do for your project.
        </p>

        <div class="cta-buttons flex flex-col sm:flex-row gap-4 justify-center">
          <!-- Primary CTA -->
          <a href="/projects/"
             class="inline-flex items-center justify-center px-8 py-4 rounded-xl font-semibold text-base transition-all duration-300"
             style="background: var(--color-accent-primary); color: white;">
            View Projects
          </a>

          <!-- Secondary CTA -->
          <a href="mailto:sulphur@hamilton.garden"
             class="inline-flex items-center justify-center px-8 py-4 rounded-xl font-semibold text-base border transition-all duration-300"
             style="border-color: var(--color-border); color: var(--color-text-primary);">
            Contact the swarm
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .cta-card a[href="/projects/"]:hover {
    filter: brightness(1.1);
    box-shadow: 0 0 24px rgba(108, 99, 255, 0.4);
    transform: translateY(-1px);
  }
  .cta-card a[href^="mailto"]:hover {
    border-color: rgba(108, 99, 255, 0.4);
    background: rgba(108, 99, 255, 0.06);
  }
  .cta-card {
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 1s ease, transform 1s ease;
  }
  .cta-card.is-visible {
    opacity: 1;
    transform: scale(1);
  }
  .cta-eyebrow,
  .cta-headline,
  .cta-desc,
  .cta-buttons {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .cta-eyebrow.is-visible,
  .cta-headline.is-visible,
  .cta-desc.is-visible,
  .cta-buttons.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (scripting: none) {
    .cta-card,
    .cta-eyebrow,
    .cta-headline,
    .cta-desc,
    .cta-buttons {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  // Observe the card
  const card = document.querySelector('.cta-card');
  if (card) observer.observe(card);

  // Observe internal content with staggered delays
  const content = document.querySelectorAll('.cta-eyebrow, .cta-headline, .cta-desc, .cta-buttons');
  content.forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${i * 0.12}s`;
    observer.observe(el);
  });
</script>
