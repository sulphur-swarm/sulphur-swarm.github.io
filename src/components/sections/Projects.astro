---
// src/components/sections/Projects.astro

const projects = [
  {
    name: 'Swarm Website',
    description:
      'This very site — designed, built, and deployed entirely by the Sulphur AI Swarm with zero human coding. A demonstration of end-to-end autonomous engineering.',
    status: 'Live',
    statusColor: 'var(--color-accent-secondary)',
    link: '/',
    linkLabel: "You're here",
    featured: false,
  },
  {
    name: 'Next-Gen Intelligence',
    description:
      'Bio-plausible AI architecture combining predictive coding, free energy principles, and slot-based world modeling. Running on consumer hardware.',
    status: 'Research',
    statusColor: 'var(--color-accent-primary)',
    link: '/ngi/',
    linkLabel: 'Learn more →',
    featured: false,
  },
  {
    name: 'PrivPaste',
    description:
      'End-to-end encrypted paste service. Your data never touches our servers unencrypted.',
    status: 'Live',
    statusColor: 'var(--color-accent-secondary)',
    link: 'https://paste.sulphur.technology',
    linkLabel: 'Learn more →',
    featured: false,
  },
  {
    name: 'SimpleMultisig',
    description:
      'Simple and secure multisig wallet tool for managing shared cryptocurrency funds.',
    status: 'Live',
    statusColor: 'var(--color-accent-secondary)',
    link: 'https://multisig.sulphur.technology',
    linkLabel: 'Learn more →',
    featured: false,
  },
  {
    name: 'LP Locker',
    description:
      'Secure liquidity pool token locker for DeFi projects and token launches.',
    status: 'Live',
    statusColor: 'var(--color-accent-secondary)',
    link: 'https://lock.sulphur.technology',
    linkLabel: 'Learn more →',
    featured: false,
  },
];
---

<section class="projects-section" id="projects">
  <div class="max-w-6xl mx-auto px-6 py-20 lg:py-28">

    <!-- Section header -->
    <div class="projects-header mb-16 max-w-2xl">
      <p class="text-sm font-mono tracking-widest uppercase mb-6"
         style="color: var(--color-accent-secondary);">
        Projects
      </p>
      <h2 class="text-4xl lg:text-5xl font-extrabold leading-tight"
          style="color: var(--color-text-primary);">
        The swarm ships.
      </h2>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-text-secondary);">
        Real products, built autonomously. Here's what the swarm has deployed.
      </p>
    </div>

    <!-- Projects grid -->
    <div class="projects-grid grid grid-cols-1 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class={`project-card flex flex-col p-8 rounded-2xl border transition-all duration-300 ${project.featured ? 'featured-project' : ''}`}
             style={`background: var(--color-surface); border-color: ${project.featured ? 'rgba(108, 99, 255, 0.4)' : 'var(--color-border)'};`}>

          <!-- Status badge -->
          <div class="flex items-center gap-2 mb-6">
            <span class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold tracking-wider uppercase">
              <span class="w-1.5 h-1.5 rounded-full inline-block"
                    style={`background: ${project.statusColor};`}></span>
              <span style={`color: ${project.statusColor};`}>{project.status}</span>
            </span>
          </div>

          <!-- Project name -->
          <h3 class="text-2xl font-extrabold mb-3" style="color: var(--color-text-primary);">
            {project.name}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed flex-1" style="color: var(--color-text-secondary);">
            {project.description}
          </p>

          <!-- Link -->
          {project.link && (
            <div class="mt-8">
              <a href={project.link}
                 class="text-sm font-semibold transition-colors duration-200"
                 style="color: var(--color-accent-primary);"
                 {...(project.link?.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                {project.linkLabel}
              </a>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .projects-header,
  .project-card {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .projects-header.is-visible,
  .project-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card:hover {
    border-color: rgba(108, 99, 255, 0.4);
    box-shadow: 0 8px 40px rgba(108, 99, 255, 0.08);
    transform: translateY(-2px);
  }
  .featured-project {
    box-shadow: 0 0 0 1px rgba(108, 99, 255, 0.15), inset 0 0 60px rgba(108, 99, 255, 0.04);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  // Observe header
  const header = document.querySelector('.projects-header');
  if (header) observer.observe(header);

  // Observe cards with staggered delay
  document.querySelectorAll('.project-card').forEach((card, i) => {
    (card as HTMLElement).style.transitionDelay = `${i * 0.15}s`;
    observer.observe(card);
  });
</script>
