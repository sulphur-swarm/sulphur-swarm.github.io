---
// src/components/lplocker/HowItWorks.astro
import SectionHeader from '../ui/SectionHeader.astro';

const steps = [
  {
    number: '01',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
    title: 'Connect Your Wallet',
    description: 'Open the app and connect with MetaMask or WalletConnect v2 via EIP-6963 wallet discovery. No extensions required beyond your preferred wallet.',
  },
  {
    number: '02',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: 'Browse Existing Locks',
    description: 'Use the lock browser to search locks by token address or project. View full details — token pair, amount, unlock date, and owner — directly in the UI.',
  },
  {
    number: '03',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>`,
    title: 'Start a New Lock',
    description: 'Enter your LP token address. The app fetches token metadata on-chain and shows your balance. Confirm the amount and unlock duration (minimum 30 days).',
  },
  {
    number: '04',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'Approve & Pay the Fee',
    description: 'Approve the contract to spend your LP tokens, then send the lock transaction with 0.005 ETH. Two wallet confirmations — approval then lock — and you\'re done.',
  },
  {
    number: '05',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>`,
    title: 'Lock Recorded On-Chain',
    description: 'Your LP tokens are transferred to the immutable contract. The lock is recorded on-chain and immediately visible in the lock browser — publicly verifiable by anyone.',
  },
  {
    number: '06',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 019.9-1M17 11V7"/></svg>`,
    title: 'Withdraw or Extend',
    description: 'After the unlock date, withdraw your LP tokens at any time. Or, extend the lock before it expires for 0.0025 ETH — directly from the lock detail view.',
  },
];
---

<section class="lp-hiw-section">
  <div class="lp-hiw-container">
    <SectionHeader
      eyebrow="How It Works"
      title="Lock in six simple steps"
      subtitle="From wallet connect to on-chain proof of liquidity lock — in minutes."
    />

    <div class="lp-hiw-wrapper">
      <!-- SVG connecting line (desktop) -->
      <div class="lp-hiw-line-container" aria-hidden="true">
        <svg id="lp-hiw-line-svg" viewBox="0 0 4 400" preserveAspectRatio="none">
          <line x1="2" y1="0" x2="2" y2="400"
            stroke="rgba(108,99,255,0.2)" stroke-width="2" stroke-dasharray="6 4" />
          <circle id="lp-hiw-dot" cx="2" cy="0" r="5" fill="var(--color-accent-primary)"
            style="filter:drop-shadow(0 0 6px rgba(108,99,255,0.8));" />
        </svg>
      </div>

      <!-- Steps -->
      <div class="lp-hiw-steps">
        {steps.map((step, i) => (
          <div class="lp-hiw-step" data-step={i}>
            <div class="lp-step-number">{step.number}</div>
            <div class="lp-step-card">
              <div class="lp-step-icon" set:html={step.icon} />
              <div class="lp-step-content">
                <h3 class="lp-step-title">{step.title}</h3>
                <p class="lp-step-desc">{step.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .lp-hiw-section {
    padding: 6rem 1.5rem 8rem;
    background: var(--color-bg);
  }
  .lp-hiw-container {
    max-width: 900px;
    margin: 0 auto;
  }
  .lp-hiw-wrapper {
    position: relative;
    display: flex;
    gap: 2rem;
  }
  .lp-hiw-line-container {
    flex-shrink: 0;
    width: 20px;
    display: none;
  }
  @media (min-width: 768px) {
    .lp-hiw-line-container { display: block; }
  }
  #lp-hiw-line-svg { width: 100%; height: 100%; }

  .lp-hiw-steps {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .lp-hiw-step {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    opacity: 0;
    transform: translateY(30px);
  }
  .lp-step-number {
    font-family: 'Geist Mono', monospace;
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    color: rgba(108, 99, 255, 0.06);
    flex-shrink: 0;
    width: 4rem;
    text-align: right;
    user-select: none;
  }
  .lp-step-card {
    flex: 1;
    background: rgba(14, 17, 23, 0.6);
    border: 1px solid rgba(108, 99, 255, 0.15);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    backdrop-filter: blur(8px);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .lp-step-card:hover {
    border-color: rgba(108, 99, 255, 0.4);
    box-shadow: 0 0 24px rgba(108, 99, 255, 0.12);
  }
  .lp-step-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    color: var(--color-accent-primary);
  }
  .lp-step-icon svg { width: 100%; height: 100%; }
  .lp-step-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.4rem;
  }
  .lp-step-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.to('.lp-hiw-step', {
    opacity: 1,
    y: 0,
    duration: 0.6,
    stagger: 0.15,
    ease: 'power2.out',
    scrollTrigger: {
      trigger: '.lp-hiw-steps',
      start: 'top 80%',
      once: true,
    },
  });

  const dot = document.getElementById('lp-hiw-dot');
  if (dot) {
    gsap.fromTo(
      dot,
      { attr: { cy: 0 } },
      {
        attr: { cy: 400 },
        ease: 'none',
        scrollTrigger: {
          trigger: '.lp-hiw-steps',
          start: 'top 80%',
          end: 'bottom 20%',
          scrub: 1,
        },
      }
    );
  }
</script>
