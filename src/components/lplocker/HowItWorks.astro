---
// src/components/lplocker/HowItWorks.astro
import SectionHeader from '../ui/SectionHeader.astro';

const steps = [
  {
    number: '01',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    title: 'Choose Your LP Token',
    description: 'Select the DEX LP token pair you want to lock. Any ERC-20 LP token on Base is supported.',
  },
  {
    number: '02',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 4v4m0 4h.01"/><circle cx="12" cy="16" r="1" fill="currentColor"/></svg>`,
    title: 'Pay the Lock Fee',
    description: 'Send 0.005 ETH along with your lock transaction. The fee keeps the contract sustainable and spam-free.',
  },
  {
    number: '03',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>`,
    title: 'Tokens Are Locked On-Chain',
    description: 'Your LP tokens are transferred to the contract and locked for a minimum of 30 days. The lock is recorded on-chain — publicly verifiable by anyone.',
  },
  {
    number: '04',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 019.9-1M17 11V7"/></svg>`,
    title: 'Withdraw After Expiry',
    description: 'Once the lock period ends, withdraw your LP tokens at any time. Optionally extend the lock before expiry for 0.0025 ETH.',
  },
];
---

<section class="lp-hiw-section">
  <div class="lp-hiw-container">
    <SectionHeader
      eyebrow="How It Works"
      title="Lock in four simple steps"
      subtitle="From LP token to on-chain proof of liquidity lock — in minutes."
    />

    <div class="lp-hiw-wrapper">
      <!-- SVG connecting line (desktop) -->
      <div class="lp-hiw-line-container" aria-hidden="true">
        <svg id="lp-hiw-line-svg" viewBox="0 0 4 400" preserveAspectRatio="none">
          <line x1="2" y1="0" x2="2" y2="400"
            stroke="rgba(108,99,255,0.2)" stroke-width="2" stroke-dasharray="6 4" />
          <circle id="lp-hiw-dot" cx="2" cy="0" r="5" fill="var(--color-accent-primary)"
            style="filter:drop-shadow(0 0 6px rgba(108,99,255,0.8));" />
        </svg>
      </div>

      <!-- Steps -->
      <div class="lp-hiw-steps">
        {steps.map((step, i) => (
          <div class="lp-hiw-step" data-step={i}>
            <div class="lp-step-number">{step.number}</div>
            <div class="lp-step-card">
              <div class="lp-step-icon" set:html={step.icon} />
              <div class="lp-step-content">
                <h3 class="lp-step-title">{step.title}</h3>
                <p class="lp-step-desc">{step.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .lp-hiw-section {
    padding: 6rem 1.5rem 8rem;
    background: var(--color-bg);
  }
  .lp-hiw-container {
    max-width: 900px;
    margin: 0 auto;
  }
  .lp-hiw-wrapper {
    position: relative;
    display: flex;
    gap: 2rem;
  }
  .lp-hiw-line-container {
    flex-shrink: 0;
    width: 20px;
    display: none;
  }
  @media (min-width: 768px) {
    .lp-hiw-line-container { display: block; }
  }
  #lp-hiw-line-svg { width: 100%; height: 100%; }

  .lp-hiw-steps {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .lp-hiw-step {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    opacity: 0;
    transform: translateY(30px);
  }
  .lp-step-number {
    font-family: 'Geist Mono', monospace;
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    color: rgba(108, 99, 255, 0.06);
    flex-shrink: 0;
    width: 4rem;
    text-align: right;
    user-select: none;
  }
  .lp-step-card {
    flex: 1;
    background: rgba(14, 17, 23, 0.6);
    border: 1px solid rgba(108, 99, 255, 0.15);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    backdrop-filter: blur(8px);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .lp-step-card:hover {
    border-color: rgba(108, 99, 255, 0.4);
    box-shadow: 0 0 24px rgba(108, 99, 255, 0.12);
  }
  .lp-step-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    color: var(--color-accent-primary);
  }
  .lp-step-icon svg { width: 100%; height: 100%; }
  .lp-step-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.4rem;
  }
  .lp-step-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.to('.lp-hiw-step', {
    opacity: 1,
    y: 0,
    duration: 0.6,
    stagger: 0.15,
    ease: 'power2.out',
    scrollTrigger: {
      trigger: '.lp-hiw-steps',
      start: 'top 80%',
      once: true,
    },
  });

  const dot = document.getElementById('lp-hiw-dot');
  if (dot) {
    gsap.fromTo(
      dot,
      { attr: { cy: 0 } },
      {
        attr: { cy: 400 },
        ease: 'none',
        scrollTrigger: {
          trigger: '.lp-hiw-steps',
          start: 'top 80%',
          end: 'bottom 20%',
          scrub: 1,
        },
      }
    );
  }
</script>
