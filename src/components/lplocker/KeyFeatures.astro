---
// src/components/lplocker/KeyFeatures.astro
import SectionHeader from '../ui/SectionHeader.astro';

const features = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Immutable',
    description: 'Deployed once, never upgraded. No admin keys. No backdoors. Code is law.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Full Frontend App',
    description: 'A complete web interface: landing page, lock creation wizard (token info → approve → lock), and a searchable lock browser with detail, unlock, and extend flows.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
    title: 'EIP-6963 Wallet Connection',
    description: 'Connect with MetaMask or WalletConnect v2 via the EIP-6963 multi-wallet standard. No vendor lock-in.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: 'Lock Browser',
    description: 'Search and filter all on-chain locks by token, address, or status. View full lock details, then unlock or extend from the same interface.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: '0.005 ETH Lock Fee',
    description: 'A flat 0.005 ETH fee to create a lock. Predictable, fair, and low.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11A8.1 8.1 0 004.5 9M4 5v4h4M4 13a8.1 8.1 0 0015.5 2m.5 4v-4h-4"/></svg>`,
    title: '0.0025 ETH Extension Fee',
    description: 'Extend any active lock for half the lock fee. Flexibility without compromise.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2v-4M9 21H5a2 2 0 01-2-2v-4m0 0h18"/></svg>`,
    title: 'Fuzz & Invariant Tests',
    description: 'Foundry fuzz tests and invariant tests hammer the contract with randomized inputs to surface edge cases no unit test can find.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
    title: 'Gas Benchmarks',
    description: 'Every critical path is gas-benchmarked. Know exactly what each operation costs before deploying.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11A8.1 8.1 0 004.5 9M4 5v4h4M4 13a8.1 8.1 0 0015.5 2m.5 4v-4h-4"/><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'ReentrancyGuard',
    description: "Built on OpenZeppelin's ReentrancyGuard to prevent reentrancy attacks.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
    title: 'Multi-Network Deployment',
    description: 'Deployment scripts target both Base Sepolia (testnet) and Base mainnet. One command per network.',
  },
];
---

<section class="lp-features-section">
  <div class="lp-features-container">
    <SectionHeader
      eyebrow="Features"
      title="Built for trust. Built to last."
      subtitle="Every design decision in LP Locker serves one goal: making LP locks verifiably trustworthy."
    />

    <div class="lp-features-grid">
      {features.map((f) => (
        <div class="lp-feature-card">
          <div class="lp-feature-icon" set:html={f.icon} />
          <h3 class="lp-feature-title">{f.title}</h3>
          <p class="lp-feature-desc">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lp-features-section {
    padding: 6rem 1.5rem;
    background: var(--color-surface);
    position: relative;
  }
  .lp-features-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108,99,255,0.3), transparent);
  }
  .lp-features-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .lp-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .lp-features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .lp-features-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .lp-feature-card {
    background: rgba(8, 9, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    padding: 1.75rem;
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.25s, box-shadow 0.25s;
  }
  .lp-feature-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .lp-feature-card:nth-child(2) { transition-delay: 0.1s; }
  .lp-feature-card:nth-child(3) { transition-delay: 0.2s; }
  .lp-feature-card:nth-child(4) { transition-delay: 0.3s; }
  .lp-feature-card:nth-child(5) { transition-delay: 0.4s; }
  .lp-feature-card:nth-child(6) { transition-delay: 0.5s; }
  .lp-feature-card:nth-child(7) { transition-delay: 0.6s; }
  .lp-feature-card:nth-child(8) { transition-delay: 0.7s; }
  .lp-feature-card:nth-child(9) { transition-delay: 0.8s; }
  .lp-feature-card:nth-child(10) { transition-delay: 0.9s; }
  .lp-feature-card:hover {
    transform: translateY(-3px) !important;
    border-color: rgba(108, 99, 255, 0.3);
    box-shadow: 0 8px 30px rgba(108, 99, 255, 0.1);
  }
  @media (scripting: none) {
    .lp-feature-card { opacity: 1; transform: none; }
  }
  .lp-feature-icon {
    width: 44px;
    height: 44px;
    color: var(--color-accent-primary);
    margin-bottom: 1rem;
  }
  .lp-feature-icon svg { width: 100%; height: 100%; }
  .lp-feature-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
  }
  .lp-feature-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.lp-feature-card').forEach(el => el.classList.add('is-visible'));
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  const grid = document.querySelector('.lp-features-grid');
  if (grid) observer.observe(grid);
</script>
