---
// src/components/lplocker/KeyFeatures.astro
import SectionHeader from '../ui/SectionHeader.astro';

const features = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Immutable',
    description: 'Deployed once, never upgraded. No admin keys. No backdoors. Code is law.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 4v4m0 4h.01"/><circle cx="12" cy="12" r="3"/></svg>`,
    title: '0.005 ETH Lock Fee',
    description: 'A flat 0.005 ETH fee to create a lock. Predictable, fair, and low.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: '0.0025 ETH Extension Fee',
    description: 'Extend any active lock for half the lock fee. Flexibility without compromise.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11A8.1 8.1 0 004.5 9M4 5v4h4M4 13a8.1 8.1 0 0015.5 2m.5 4v-4h-4"/></svg>`,
    title: 'ReentrancyGuard',
    description: "Built on OpenZeppelin's ReentrancyGuard to prevent reentrancy attacks.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'SafeERC20',
    description: "Uses OpenZeppelin's SafeERC20 for safe token transfers across all ERC-20 variants.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Base L2 Native',
    description: 'Deployed on Base — fast, cheap, and Ethereum-secured.',
  },
];
---

<section class="lp-features-section">
  <div class="lp-features-container">
    <SectionHeader
      eyebrow="Features"
      title="Built for trust. Built to last."
      subtitle="Every design decision in LP Locker serves one goal: making LP locks verifiably trustworthy."
    />

    <div class="lp-features-grid">
      {features.map((f) => (
        <div class="lp-feature-card">
          <div class="lp-feature-icon" set:html={f.icon} />
          <h3 class="lp-feature-title">{f.title}</h3>
          <p class="lp-feature-desc">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lp-features-section {
    padding: 6rem 1.5rem;
    background: var(--color-surface);
    position: relative;
  }
  .lp-features-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108,99,255,0.3), transparent);
  }
  .lp-features-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .lp-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .lp-features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .lp-features-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .lp-feature-card {
    background: rgba(8, 9, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    padding: 1.75rem;
    backdrop-filter: blur(8px);
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    opacity: 0;
    transform: translateY(24px);
  }
  .lp-feature-card:hover {
    transform: translateY(-3px) !important;
    border-color: rgba(108, 99, 255, 0.3);
    box-shadow: 0 8px 30px rgba(108, 99, 255, 0.1);
  }
  .lp-feature-icon {
    width: 44px;
    height: 44px;
    color: var(--color-accent-primary);
    margin-bottom: 1rem;
  }
  .lp-feature-icon svg { width: 100%; height: 100%; }
  .lp-feature-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
  }
  .lp-feature-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.to('.lp-feature-card', {
    opacity: 1,
    y: 0,
    duration: 0.5,
    stagger: 0.1,
    ease: 'power2.out',
    scrollTrigger: {
      trigger: '.lp-features-grid',
      start: 'top 80%',
      once: true,
    },
  });
</script>
