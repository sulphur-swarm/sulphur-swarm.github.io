---
// src/components/swarmfix/PRHighlights.astro
import SectionHeader from '../ui/SectionHeader.astro';

const prs = [
  {
    project: 'Bun',
    org: 'oven-sh',
    description: 'Fixed a runtime edge-case in Bun\'s bundler that caused silent output corruption on certain import patterns. Merged into the main release.',
  },
  {
    project: 'Astro',
    org: 'withastro',
    description: 'Resolved a compiler regression affecting dynamic slot handling in nested island components. Fix shipped in a patch release.',
  },
  {
    project: 'Slither',
    org: 'crytic',
    description: 'Patched a false-negative in Slither\'s detector pipeline that allowed re-entrancy vulnerabilities to slip through static analysis.',
  },
  {
    project: 'OpenZeppelin',
    org: 'OpenZeppelin',
    description: 'Corrected boundary handling in a standard ERC token implementation, strengthening smart contract security for thousands of downstream users.',
  },
  {
    project: 'Meilisearch',
    org: 'meilisearch',
    description: 'Fixed a ranking rule edge-case that caused inconsistent sort order on tied relevance scores.',
  },
  {
    project: 'Prometheus',
    org: 'prometheus',
    description: 'Resolved a label cardinality issue in the scrape loop that caused memory growth under high-churn metric targets.',
  },
  {
    project: 'Quarkus',
    org: 'quarkusio',
    description: 'Patched a CDI bean lifecycle bug that caused intermittent NullPointerException on application startup.',
  },
  {
    project: 'RuboCop',
    org: 'rubocop',
    description: 'Fixed an auto-correct false-positive in the Style/Lambda cop that generated syntactically invalid Ruby.',
  },
  {
    project: 'nerdctl',
    org: 'containerd',
    description: 'Corrected volume mount flag parsing that conflicted with OCI spec defaults in bridge-mode networking.',
  },
];
---

<section class="pr-section">
  <div class="pr-container">
    <SectionHeader
      eyebrow="Track Record"
      title="Real fixes. Real repos. Already merged."
      subtitle="The swarm doesn't just fix your bugs — it contributes autonomously to the world's most critical open-source projects."
    />

    <div class="pr-grid">
      {prs.map((pr) => (
        <div class="pr-card">
          <div class="pr-card-top">
            <span class="pr-project">{pr.project}</span>
            <span class="pr-badge">✓ Merged</span>
          </div>
          <p class="pr-description">{pr.description}</p>
          <div class="pr-org">@{pr.org}/{pr.project.toLowerCase()}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pr-section {
    padding: 6rem 1.5rem;
    background: var(--color-surface);
    position: relative;
  }
  .pr-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(108, 99, 255, 0.3), transparent);
  }
  .pr-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .pr-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .pr-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .pr-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .pr-card {
    background: rgba(8, 9, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    padding: 1.75rem;
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    opacity: 0;
    transform: translateY(24px);
  }
  .pr-card:hover {
    transform: translateY(-3px) !important;
    border-color: rgba(108, 99, 255, 0.3);
    box-shadow: 0 8px 30px rgba(108, 99, 255, 0.1);
  }
  .pr-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .pr-project {
    font-family: 'Geist Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .pr-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(74, 222, 128, 0.9);
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.25);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
    letter-spacing: 0.04em;
  }
  .pr-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .pr-org {
    font-family: 'Geist Mono', monospace;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.03em;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.to('.pr-card', {
    opacity: 1,
    y: 0,
    duration: 0.5,
    stagger: 0.08,
    ease: 'power2.out',
    scrollTrigger: {
      trigger: '.pr-grid',
      start: 'top 80%',
      once: true,
    },
  });
</script>
