---
// src/pages/swarmfix.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import ProblemSolution from '../components/swarmfix/ProblemSolution.astro';
import HowItWorks from '../components/swarmfix/HowItWorks.astro';
import FeaturesGrid from '../components/swarmfix/FeaturesGrid.astro';
import PricingSection from '../components/swarmfix/PricingSection.astro';
import CTABanner from '../components/sections/CTABanner.astro';
---

<BaseLayout
  title="SwarmFix — Automated OSS Bug Fixing | Sulphur AI Swarm"
  description="Deploy the Sulphur AI Swarm to fix bugs in your open source project. Automated, precise, and relentless."
>
  <!-- 1. Hero -->
  <PageHero
    title="SwarmFix"
    subtitle="Let the swarm fix your bugs. Automated, precise, relentless."
    badge="OSS Code Fixing"
    breadcrumb="SwarmFix"
  />

  <!-- 2. Problem / Solution Pitch -->
  <ProblemSolution />

  <!-- 3. How It Works -->
  <HowItWorks />

  <!-- 4. Features Grid -->
  <FeaturesGrid />

  <!-- 5. Pricing -->
  <PricingSection />

  <!-- 6. CTA Banner -->
  <CTABanner
    title="Ready to fix your codebase?"
    subtitle="Be among the first projects to use the Sulphur swarm."
    primaryHref="https://fix.sulphur.technology"
    primaryLabel="Try SwarmFix"
    secondaryHref="/contact/"
    secondaryLabel="Get Started Free"
  />
</BaseLayout>
